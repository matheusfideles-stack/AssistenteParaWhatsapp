<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.assistente</groupId>
  <artifactId>assistente-backend</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Assistente Pessoal - Backend</name>
  <description>Backend Java (Spring Boot) com a logica de tarefas e lembretes, consumido pelo bot do WhatsApp em Node.js - 100% local, gratuito e sem servicos pagos.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sqlite.version>3.46.1.3</sqlite.version>
    <mockito.version>5.24.0</mockito.version>
    <!-- O BOM do spring-boot-starter-parent fixa uma versao antiga de
         byte-buddy (1.14.19) que nao reconhece a class file version do
         JDK 26 ("Unknown Java version: 0"), quebrando o mock inline do
         Mockito. Forcamos a mesma versao que o Mockito 5.24.0 traz por
         padrao sem esse BOM (1.17.7), que ja suporta JDK 26. -->
    <byte-buddy.version>1.17.7</byte-buddy.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Banco SQLite local: arquivo unico, sem servidor, sem configuracao. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
